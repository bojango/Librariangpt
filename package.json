{
  "name": "reading-room",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --minify --sourcemap --outfile=dist/app.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check": "node scripts/check-runtime.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.25.9"
  },
  "dependencies": {
    "@fontsource/commit-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@supabase/supabase-js": "2.57.4"
  }
}
